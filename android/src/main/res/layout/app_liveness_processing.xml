<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- SDK still drives state and owns the real retry/cancel actions. -->
    <FrameLayout android:layout_width="1dp" android:layout_height="1dp"
        android:alpha="0" android:importantForAccessibility="noHideDescendants">
        <View android:id="@+id/app_face_close" android:layout_width="1dp" android:layout_height="1dp" />
        <FrameLayout android:id="@+id/app_face_processing" android:layout_width="1dp" android:layout_height="1dp" />
        <FrameLayout android:id="@+id/app_face_retry" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
            <View android:id="@+id/app_face_retry_button" android:layout_width="1dp" android:layout_height="1dp" />
            <View android:id="@+id/app_face_retry_default" android:layout_width="1dp" android:layout_height="1dp" />
            <View android:id="@+id/app_face_retry_quality" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/app_face_verified" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    </FrameLayout>
    <FrameLayout android:id="@+id/app_face_flutter" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
