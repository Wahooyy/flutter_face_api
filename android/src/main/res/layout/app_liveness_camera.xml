<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- SDK action/status targets only; all visible UI is Flutter. -->
    <FrameLayout android:layout_width="1dp" android:layout_height="1dp"
        android:alpha="0" android:importantForAccessibility="noHideDescendants">
        <View android:id="@+id/app_face_close" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/app_face_swap" android:layout_width="1dp" android:layout_height="1dp" />
        <View android:id="@+id/app_face_flash" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/app_face_notification" android:layout_width="1dp" android:layout_height="1dp" />
    </FrameLayout>
    <FrameLayout android:id="@+id/app_face_flutter" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
